{
  "manifest_version": 3,
  "name": "BrowserForge",
  "version": "0.1.0",
  "description": "Create a reusable BrowserForge Skill from the current form.",
  "permissions": ["activeTab", "scripting", "tabs", "storage"],
  "host_permissions": ["http://*/*", "https://*/*"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Create BrowserForge Skill",
    "default_popup": "popup.html"
  }
}
